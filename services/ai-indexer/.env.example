APP_NAME=kibegi-ai-indexer
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8090
SERVICE_TOKEN=

DATABASE_URL=postgresql://user:password@localhost:5432/kibegi_db
DB_MIN_SIZE=1
DB_MAX_SIZE=8
JOB_STALE_MINUTES=15
DEFAULT_BATCH_LIMIT=100

REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_KEY=kibegi:ai:indexing:queue
REDIS_LOCK_PREFIX=kibegi:ai:indexing:lock:

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_SECURE=false
MINIO_REGION=us-east-1

NGAMIA_BASE_URL=https://api.ngamia.cc/v1
NGAMIA_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=20
EMBEDDING_TIMEOUT_SECONDS=60

MAX_DOWNLOAD_BYTES=52428800
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
