# Django settings
SECRET_KEY=changeme
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (example for PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=kibegi_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# MinIO S3-Compatible Storage
# Get these credentials from your MinIO console
AWS_ACCESS_KEY_ID=your-minio-access-key
AWS_SECRET_ACCESS_KEY=your-minio-secret-key
AWS_STORAGE_BUCKET_NAME=kibegi-uploads
AWS_S3_ENDPOINT_URL=https://194.163.153.255:9000
AWS_S3_REGION_NAME=us-east-1

# MinIO Connection Options
AWS_S3_USE_SSL=True
AWS_S3_VERIFY=True

# Access Control (True for private buckets - generates signed URLs)
AWS_QUERYSTRING_AUTH=True

# Optional: Custom domain for CDN or direct access
# AWS_S3_CUSTOM_DOMAIN=cdn.kibegi.com

# Optional: Signed URL expiration time (in seconds, default: 3600)
# AWS_QUERYSTRING_EXPIRE=3600

# Email settings (used for password reset / OTP)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=you@example.com
EMAIL_HOST_PASSWORD=supersecret
EMAIL_USE_TLS=True

# OTP settings
OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6

# Logging settings
ENABLE_MINIO_LOG_UPLOAD=True
