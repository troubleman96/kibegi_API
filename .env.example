# ─────────────────────────────────────────────
# Django
# Generate a new key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# ─────────────────────────────────────────────
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=api.kibegi.com,194.163.153.255,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://kibegi.com,https://www.kibegi.com,http://localhost:5173,http://localhost:3000

# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=kibegi_db
DB_USER=kibegi_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# ─────────────────────────────────────────────
# MinIO / S3 Storage
# ─────────────────────────────────────────────
MINIO_ENABLED=True
MINIO_API_ENDPOINT=storage.kibegi.com
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET=kibegi-uploads
MINIO_SECURE=True
MINIO_PUBLIC_BASE_URL=https://storage.kibegi.com/kibegi-uploads/
AWS_S3_REGION_NAME=us-east-1
AWS_QUERYSTRING_AUTH=False
AWS_QUERYSTRING_EXPIRE=3600
ENABLE_MINIO_LOG_UPLOAD=True

# ─────────────────────────────────────────────
# Email (SMTP)
# ─────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Kibegi <your-email@gmail.com>

# ─────────────────────────────────────────────
# OTP
# ─────────────────────────────────────────────
OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6

# ─────────────────────────────────────────────
# Africa's Talking SMS
# ─────────────────────────────────────────────
AFRICASTALKING_USERNAME=your-africastalking-username
AFRICASTALKING_API_KEY=your-africastalking-api-key
AFRICASTALKING_SENDER_ID=KiBEGI
AFRICASTALKING_SMS_URL=https://api.africastalking.com/version1/messaging
SCHEDULE_SMS_COST_PER_MESSAGE=1
SCHEDULE_SMS_GRACE_MINUTES=10
SCHEDULE_SMS_LOOKAHEAD_DAYS=7
CLASS_COMMS_SMS_COST_PER_MESSAGE=1

# ─────────────────────────────────────────────
# Redis (cache, rate limits, locks, idempotency, and future queues)
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=5
CACHE_DEFAULT_TTL=5m
REDIS_PING_TIMEOUT=1s

# ─────────────────────────────────────────────
# Go runtime (used by the incremental Go service)
# ─────────────────────────────────────────────
HTTP_ADDR=:8080
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
DATABASE_PING_TIMEOUT=2s
SHUTDOWN_TIMEOUT=10s

# ─────────────────────────────────────────────
# Schedule app
# ─────────────────────────────────────────────
SCHEDULE_FRONTEND_URL=https://kibegi.com/schedule

# ─────────────────────────────────────────────
# Kibegi AI (Ngamia gateway) — https://docs.ngamia.cc
# Shared key used when a user hasn't pasted their own in Settings.
# ─────────────────────────────────────────────
NGAMIA_API_KEY=ngm_your-shared-key
NGAMIA_BASE_URL=https://api.ngamia.cc/v1
AI_CHAT_MODEL=openai/gpt-4o-mini
AI_DAILY_TOKEN_LIMIT=50000

# Embeddings — also routed through Ngamia (model may not be supported yet, so
# file processing falls back to keyword search if the call fails).
# EMBEDDING_MODEL=openai/text-embedding-3-small
