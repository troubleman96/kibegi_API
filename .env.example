# Kibegi Go API
HTTP_ADDR=:8080
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_LIFETIME=1h
REFRESH_TOKEN_LIFETIME=168h
KIBEGI_CORS_ORIGIN=https://kibegi.com

# PostgreSQL: existing Kibegi/Django-compatible schema
DATABASE_URL=postgres://user:password@localhost:5432/kibegi_db?sslmode=disable
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
DATABASE_PING_TIMEOUT=2s
SHUTDOWN_TIMEOUT=10s

# Redis: cache, locks, counters, rate limits, token revocation, and coordination
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=5
CACHE_DEFAULT_TTL=5m
REDIS_PING_TIMEOUT=1s

# MinIO/S3-compatible object storage
MINIO_ENABLED=true
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=replace-with-access-key
MINIO_SECRET_KEY=replace-with-secret-key
MINIO_BUCKET=kibegi-uploads
MINIO_SECURE=false
MINIO_PUBLIC_BASE_URL=http://localhost:9000/kibegi-uploads

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Kibegi <noreply@example.com>
SMTP_STARTTLS=true

# SendAfrica SMS
SENDAFRICA_API_KEY=
SENDAFRICA_BASE_URL=https://api.sendafrica.online
SENDAFRICA_SENDER_ID=Kibegi

# Optional AI provider configuration used by Go AI endpoints
NGAMIA_API_KEY=
NGAMIA_BASE_URL=https://api.ngamia.cc/v1
AI_CHAT_MODEL=openai/gpt-4o-mini
AI_DAILY_TOKEN_LIMIT=50000

# FastAPI AI indexer sidecar called asynchronously after Go uploads
AI_INDEXER_URL=http://127.0.0.1:8090
AI_INDEXER_TOKEN=

# FastAPI/FastMCP agent gateway
GO_API_BASE_URL=http://127.0.0.1:8080
GO_API_SERVICE_TOKEN=
MCP_PATH=/mcp
MCP_ALLOWED_ORIGINS=
