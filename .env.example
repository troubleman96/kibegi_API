# ─────────────────────────────────────────────
# Django
# Generate a new key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# ─────────────────────────────────────────────
SECRET_KEY=your-secret-key-here
DEBUG=False

# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=kibegi_db
DB_USER=kibegi_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# ─────────────────────────────────────────────
# MinIO / S3 Storage
# ─────────────────────────────────────────────
MINIO_ENABLED=True
MINIO_API_ENDPOINT=storage.kibegi.com
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET=kibegi-uploads
MINIO_SECURE=True
MINIO_PUBLIC_BASE_URL=https://storage.kibegi.com/kibegi-uploads/
AWS_S3_REGION_NAME=us-east-1
AWS_QUERYSTRING_AUTH=False
AWS_QUERYSTRING_EXPIRE=3600
ENABLE_MINIO_LOG_UPLOAD=True

# ─────────────────────────────────────────────
# Email (SMTP)
# ─────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Kibegi <your-email@gmail.com>

# ─────────────────────────────────────────────
# OTP
# ─────────────────────────────────────────────
OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6

# ─────────────────────────────────────────────
# Africa's Talking SMS
# ─────────────────────────────────────────────
AFRICASTALKING_USERNAME=your-africastalking-username
AFRICASTALKING_API_KEY=your-africastalking-api-key
AFRICASTALKING_SENDER_ID=KiBEGI
AFRICASTALKING_SMS_URL=https://api.africastalking.com/version1/messaging
SCHEDULE_SMS_COST_PER_MESSAGE=1
SCHEDULE_SMS_GRACE_MINUTES=10
SCHEDULE_SMS_LOOKAHEAD_DAYS=7
CLASS_COMMS_SMS_COST_PER_MESSAGE=1

# ─────────────────────────────────────────────
# Redis (for caching — optional but recommended in prod)
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────
# Schedule app
# ─────────────────────────────────────────────
SCHEDULE_FRONTEND_URL=https://kibegi.com/schedule
